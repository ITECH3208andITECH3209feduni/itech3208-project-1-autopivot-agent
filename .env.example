# Database used by SQLAlchemy and Alembic. Blank means a local SQLite file,
# autopivot.db, in the project folder: nothing to install, no server to run.
# For PostgreSQL, set a URL of this form instead. Never commit a real password.
#   DATABASE_URL=postgresql+psycopg://autopivot_user:change_me@localhost:5432/autopivot
DATABASE_URL=

# Signs login tokens. setup.sh and setup.bat fill this in when they create
# .env; left blank, every backend restart signs everyone out. To make one by
# hand:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
