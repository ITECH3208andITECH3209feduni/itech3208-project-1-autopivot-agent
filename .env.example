# AutoPivot — local configuration
#
# Copy this file to ".env" and edit it. run.bat / setup.bat create ".env" for
# you and fill in a JWT secret (scripts/ensure_env.py), so normally the only
# line you have to touch is HF_TOKEN.
#
# ".env" is git-ignored. Never commit real credentials or share them in chat.


# ── Database ──────────────────────────────────────────────────────────────────
# Left unset, AutoPivot uses a SQLite file (autopivot.db) in this folder.
# To use PostgreSQL instead, uncomment and fill in:
# DATABASE_URL=postgresql+psycopg://autopivot_user:change_me@localhost:5432/autopivot


# ── Security ──────────────────────────────────────────────────────────────────
# Signing key for login tokens. Must be at least 32 bytes.
# Left empty, scripts/ensure_env.py fills it in once. Without it a new key is
# made on every start and everyone is logged out each time the server restarts.
JWT_SECRET=


# ── Hugging Face ──────────────────────────────────────────────────────────────
# Optional token (free) from https://huggingface.co/settings/tokens — speeds up
# model downloads. Keep it private; if it is ever shared, revoke it there.
HF_TOKEN=

# Where downloaded models are cached (roughly 3–4 GB). Uncomment to keep them
# inside the project; changing it on an existing install re-downloads models.
# HF_HOME=./.cache/huggingface


# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
MAX_FILE_MB=20
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
# Where uploaded and processed images are written, relative to this folder.
STORAGE_ROOT=storage


# ── Models ────────────────────────────────────────────────────────────────────
YOLO_HF_REPO=Ultralytics/YOLO26
YOLO_MODEL_PATH=yolo26n.pt
YOLO_FALLBACK_MODEL_PATH=yolo11n.pt
ENABLE_YOLO_FALLBACK=true
# Ask CLIP what each photograph is of before processing it.
CLASSIFY_IMAGES=true


# ── Studio look ───────────────────────────────────────────────────────────────
# How far the studio is zoomed in around the car (1.0 = whole room).
STUDIO_ZOOM=1.1
# Studio lighting grade on the car (exposure, clarity, softbox streak).
STUDIO_GRADE=true
# Replace the outdoor reflections in paint and glass with studio ones.
STUDIO_RELIGHT=true
# Remove pieces of other cars (parked behind) from the cut-out. Downloads an
# outline model (yolo11m-seg.pt, ~45 MB) the first time.
VEHICLE_SEG_ENABLED=true
VEHICLE_SEG_MODEL=yolo11m-seg.pt
# Fill in tyre bottoms that background removal cut off. Off: it drew fake
# discs beside wheels on real photos.
WHEEL_GAP_PATCH=false
# Photos processed at the same time. 1 is fastest overall on a CPU.
PROCESSING_WORKERS=1


# ── Licence plates ────────────────────────────────────────────────────────────
# blur (default), pixelate, or white.
PLATE_TREATMENT=blur
# Minimum detector score before the geometry and vehicle-mask checks.
PLATE_CONFIDENCE=0.25
# Every photo also gets a second plate search on a 2x enlarged copy; the two
# are merged. Small and angled plates are found far more often. 1.0 turns it off.
PLATE_UPSCALE=2.0
# Put the AutoPivot logo on plates instead of blurring them.
PLATE_BRAND_LOGO_ENABLED=false


# ── Seed account ──────────────────────────────────────────────────────────────
# Used by "python -m scripts.seed_dealership". If SEED_ADMIN_PASSWORD is left
# blank, one is generated and printed once — copy it before closing the window.
SEED_DEALERSHIP_NAME=Demo Motors
SEED_DEALERSHIP_LOCATION=Ballarat
SEED_ADMIN_EMAIL=admin@demomotors.test
SEED_ADMIN_FIRST_NAME=Demo
SEED_ADMIN_LAST_NAME=Admin
SEED_ADMIN_PASSWORD=
